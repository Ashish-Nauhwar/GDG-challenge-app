<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_gem"
                    android:contentDescription="GEM Logo"
                    android:layout_marginEnd="8dp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GEM"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CODEQUEST"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.1"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnThemeToggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:scaleType="centerInside"
                app:tint="@color/text_primary" />
        </RelativeLayout>

        <!-- Hero Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level up your coding."
            android:textSize="32sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Practice daily. Master concepts. Track your progress."
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="32dp"/>

        <!-- Player Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="24dp">

            <!-- Streak -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginEnd="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 STREAK"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_xp"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:id="@+id/tvCurrentStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 days"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
            </LinearLayout>

            <!-- XP -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded"
                android:elevation="2dp"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ TOTAL XP"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_warning"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:id="@+id/tvTotalXp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Domains -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Domain"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="12dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="24dp"
            android:clipToPadding="false"
            android:paddingEnd="16dp">

            <RadioGroup
                android:id="@+id/rgDomains"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton android:id="@+id/rbDomainDSA" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DSA" android:background="@drawable/bg_option" android:button="@null" android:paddingHorizontal="24dp" android:paddingVertical="12dp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                <RadioButton android:id="@+id/rbDomainJS" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JavaScript" android:background="@drawable/bg_option" android:button="@null" android:paddingHorizontal="24dp" android:paddingVertical="12dp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                <RadioButton android:id="@+id/rbDomainKotlin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kotlin" android:background="@drawable/bg_option" android:button="@null" android:paddingHorizontal="24dp" android:paddingVertical="12dp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                <RadioButton android:id="@+id/rbDomainJava" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Java" android:background="@drawable/bg_option" android:button="@null" android:paddingHorizontal="24dp" android:paddingVertical="12dp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                <RadioButton android:id="@+id/rbDomainPython" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Python" android:background="@drawable/bg_option" android:button="@null" android:paddingHorizontal="24dp" android:paddingVertical="12dp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginEnd="8dp"/>

            </RadioGroup>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvDomainStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select a domain to see stats"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="24dp"/>

        <!-- Question Count -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Question Count"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="12dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp"
            android:clipToPadding="false"
            android:paddingEnd="16dp">

            <RadioGroup
                android:id="@+id/rgCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton android:id="@+id/rbCount5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:background="@drawable/bg_option" android:button="@null" android:paddingHorizontal="20dp" android:paddingVertical="10dp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                <RadioButton android:id="@+id/rbCount10" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10" android:background="@drawable/bg_option" android:button="@null" android:paddingHorizontal="20dp" android:paddingVertical="10dp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                <RadioButton android:id="@+id/rbCount15" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15" android:background="@drawable/bg_option" android:button="@null" android:paddingHorizontal="20dp" android:paddingVertical="10dp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                <RadioButton android:id="@+id/rbCount20" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20" android:background="@drawable/bg_option" android:button="@null" android:paddingHorizontal="20dp" android:paddingVertical="10dp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                <RadioButton android:id="@+id/rbCount25" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25" android:background="@drawable/bg_option" android:button="@null" android:paddingHorizontal="20dp" android:paddingVertical="10dp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                <RadioButton android:id="@+id/rbCount30" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30" android:background="@drawable/bg_option" android:button="@null" android:paddingHorizontal="20dp" android:paddingVertical="10dp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginEnd="8dp"/>

            </RadioGroup>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvLifelineNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 lifeline uses included for 10+ questions."
            android:textSize="12sp"
            android:textColor="@color/color_primary"
            android:layout_marginBottom="32dp"
            android:visibility="invisible"/>

        <!-- Actions -->
        <Button
            android:id="@+id/btnStartQuiz"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="START PRACTICE"
            android:textColor="@color/text_on_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            android:backgroundTint="@color/color_primary"
            android:layout_marginBottom="16dp"
            android:enabled="false"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnMistakeVault"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:text="MISTAKE VAULT"
                android:textColor="@color/color_error"
                android:backgroundTint="@color/bg_card"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                android:elevation="2dp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnQuizBattle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:text="QUIZ BATTLE"
                android:textColor="@color/text_secondary"
                android:backgroundTint="@color/bg_card"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                android:elevation="2dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="40dp" />

    </LinearLayout>
</ScrollView>
